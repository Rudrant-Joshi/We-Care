{
  "name": "wecare-platform",
  "version": "1.0.0",
  "private": true,
  "description": "WeCare Health Platform — Fullstack Monorepo",
  "scripts": {
    "dev": "npm --prefix backend run dev & npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test",
    "install:all": "npm --prefix frontend install && npm --prefix backend install"
  },
  "keywords": [
    "wecare",
    "healthcare",
    "appointments",
    "equipment",
    "mvc",
    "fullstack"
  ],
  "author": "Rudrant Joshi",
  "license": "Apache-2.0"
}
