rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if authenticated user is the Chief Admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'rudrant.joshi@gmail.com' ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'admin')
      );
    }

    // Helper function: Check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Appointments Collection: Clinical appointments
    match /appointments/{bookingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Users Collection: Patient & Physician Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Deleted Users Tombstone Collection: Instant multi-device sync
    match /deleted_users/{emailOrId} {
      allow read, write, delete: if true;
    }

    // Diagnostics / Health Check
    match /_connection_test/{testDoc} {
      allow read, write: if true;
    }

    // Fallback for other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
