rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if authenticated user is the Chief Admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'rudrant.joshi@gmail.com' ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'admin')
      );
    }

    // Helper function: Check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Appointments Collection: Clinical appointments
    match /appointments/{bookingId} {
      // Admins can read all appointments; authenticated users can read; public can read if looking up their booking
      allow read: if true;
      
      // Appointment Creation: Must contain required clinical booking fields
      allow create: if request.resource.data.bookingId != null
                    && request.resource.data.patientName is string
                    && request.resource.data.patientName.size() > 0
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0;

      // Status changes and notes: Allowed for admins or clinical triage
      allow update: if isAdmin() || (
        isAuthenticated() && (
          request.resource.data.userId == request.auth.uid ||
          resource.data.email == request.auth.token.email
        )
      );

      // Deletion: Restricted strictly to Chief Administrator
      allow delete: if isAdmin();
    }

    // Users Collection: Patient & Physician Profiles
    match /users/{userId} {
      // User can read and manage their own profile; Admin can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Diagnostics / Health Check
    match /_connection_test/{testDoc} {
      allow read, write: if true;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
